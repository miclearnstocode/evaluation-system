
cd ~/repositories/evaluation-system/backend
source venv/bin/activate
pip list | grep -i gunicorn

pip install -r requirements.txt
# If gunicorn is not in requirements.txt, install it separately:
pip install gunicorn

ls venv/bin/gunicorn

to start the backend
mkdir -p ~/logs
cd ~/repositories/evaluation-system/backend
export APP_ENV=production

nohup venv/bin/python3 venv/bin/gunicorn 'app:create_app()' \
  --bind 127.0.0.1:5200 \
  --workers 3 \
  --timeout 120 \
  --chdir ~/repositories/evaluation-system/backend \
  --access-logfile ~/logs/flask-access.log \
  --error-logfile ~/logs/flask-error.log \
  --pid ~/logs/flask.pid \
  --daemon